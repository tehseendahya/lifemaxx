# Scratch under scripts/ — throwaway probes written while working something out
# (often one-off database queries). Never part of the project, and the kind of
# file it would be careless to commit by accident. Which it was: the dot rule
# alone missed scripts/zz-probe-meals.ts, so both conventions are covered.
scripts/.*.ts
scripts/zz-*.ts

# Generated by scripts/build-client.mjs (the Expo web export) on every build.
# The hand-written static files it is built from live in mobile/public/.
/public/
