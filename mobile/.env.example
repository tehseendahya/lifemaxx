# Copy to `.env` and fill in. Expo inlines every EXPO_PUBLIC_* variable into the
# bundle at build time, so RESTART THE BUNDLER after editing this — a change
# here does not reach a Metro process that is already running.
#
# All three can also be set in `app.json` under `expo.extra` (apiBaseUrl,
# supabaseUrl, supabaseAnonKey); the env var wins. Use app.json if you want the
# values committed, this file if you do not.

# Where the Next.js API lives. Expo Go runs on a real phone, so `localhost`
# means the phone itself — this has to be a hostname the phone can reach. Use
# the deployed Vercel URL normally, or your laptop's LAN address (e.g.
# http://192.168.1.4:3000) to develop against `npm run dev`. It can also be
# changed at runtime in You → Connection, which is stored on the device and
# overrides this.
EXPO_PUBLIC_API_BASE_URL=

# The SAME Supabase project as the web app's NEXT_PUBLIC_SUPABASE_* — the API
# verifies the phone's bearer token against it, so a different project means
# every request 401s with a password that is perfectly correct.
EXPO_PUBLIC_SUPABASE_URL=
# Safe to ship in a client: the web app already serves it to every browser, and
# row-level security in Postgres is what actually protects the data. Never put a
# service-role key here.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Web push, browser only (You → Connections → Notifications). The PUBLIC half of
# the server's VAPID key pair, the same value as NEXT_PUBLIC_VAPID_PUBLIC_KEY.
# Empty means the row says push is not set up. Not needed for Expo Go.
EXPO_PUBLIC_VAPID_PUBLIC_KEY=
