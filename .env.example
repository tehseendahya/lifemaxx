# --- Database (Supabase → Project Settings → Database → Connection string → URI) ---
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# --- Supabase auth (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://[ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- OpenAI ---
OPENAI_API_KEY=
# Set to "fixtures" to run the whole app with no API key and no network.
LLM_PROVIDER=openai
# Audio-transcription model id, for the native client's spoken set logging.
# Deliberately left blank: unset is a supported state — POST /api/voice/transcribe
# answers 503 and the phone's mic reads "Speaking isn't set up yet — type it
# instead", while typed set entry is unaffected. Put a real id here, never a
# guessed one; an id that does not exist is a 400 that reads like an upload bug.
# `npm run llm:preflight` checks it against the models your key can see.
OPENAI_TRANSCRIBE_MODEL=

# --- Web push (generate once: npx web-push generate-vapid-keys) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Strava (https://www.strava.com/settings/api) ---
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Optional. Signs the OAuth state for Strava connect; falls back to CRON_SECRET.
# Connect is refused (503) when neither is set.
STRAVA_STATE_SECRET=

# --- Health Auto Export webhook (any random string; the iOS app sends it as a
#     Bearer token). Free alternative to a paid Strava API subscription. ---
HEALTH_WEBHOOK_SECRET=

# --- Cron auth (any random string; Vercel sends it as a Bearer token) ---
CRON_SECRET=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Native client (mobile/) ---
# Comma-separated browser origins allowed to call the API cross-origin. Empty
# means NO CORS headers are emitted at all, which is the right default: the
# native client is not CORS-constrained and the PWA is same-origin. You only
# need this for Expo's web smoke test, whose origin is http://localhost:8081.
MOBILE_CORS_ORIGINS=
#
# The phone itself is configured in mobile/, not here — see mobile/README.md.
# EXPO_PUBLIC_API_BASE_URL, EXPO_PUBLIC_SUPABASE_URL and
# EXPO_PUBLIC_SUPABASE_ANON_KEY go in mobile/.env, and the Supabase pair must
# be the same project as NEXT_PUBLIC_SUPABASE_* above or sign-in will 401.
