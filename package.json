{
  "name": "lifemaxx",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:web": "EXPO_PUBLIC_API_BASE_URL=http://localhost:3000 npm --prefix mobile run web",
    "build:client": "node scripts/build-client.mjs",
    "build": "node scripts/build-client.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:push": "npm run db:migrate",
    "db:seed": "tsx src/db/seed.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:verify": "tsx scripts/verify-db.ts",
    "llm:preflight": "tsx scripts/preflight-llm.ts",
    "strava:verify": "tsx scripts/verify-strava.ts",
    "push:verify": "tsx scripts/verify-push.ts",
    "dev:setup": "tsx scripts/dev-setup.ts",
    "db:seed:demo": "tsx scripts/seed-demo.ts",
    "runs:import": "tsx scripts/import-activities.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.36.4",
    "next": "^15.1.0",
    "openai": "^4.73.0",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.28.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.5"
  }
